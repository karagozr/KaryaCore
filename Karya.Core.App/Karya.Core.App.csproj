<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Karya.Core.App</PackageId>
    <Version>1.1.1</Version>
    <Authors>Ramazan Karagoz</Authors>
    <Company>Karagoz</Company>
    <Description>Karya Core Application Layer - CQRS and MediatR support for .NET 10</Description>
    <PackageTags>karya;core;app;cqrs;mediatr</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/karagozr/KaryaCore</PackageProjectUrl>
    <RepositoryUrl>https://github.com/karagozr/KaryaCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MediatR" Version="14.2.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Karya.Core\Karya.Core.csproj" />
	</ItemGroup>

</Project>
