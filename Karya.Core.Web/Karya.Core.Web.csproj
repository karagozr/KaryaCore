<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<EmitCompilerGeneratedFiles>false</EmitCompilerGeneratedFiles>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>Karya.Core.Web</PackageId>
		<Version>1.0.4</Version>
		<Authors>Ramazan Karagoz</Authors>
		<Company>Karagoz</Company>
		<Description>Karya Core Web Layer - ASP.NET Core utilities and OpenAPI support for .NET 10</Description>
		<PackageTags>karya;core;web;aspnetcore;openapi</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/karagozr/KaryaCore</PackageProjectUrl>
		<RepositoryUrl>https://github.com/karagozr/KaryaCore</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Interfaces\**" />
		<EmbeddedResource Remove="Interfaces\**" />
		<None Remove="Interfaces\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="MediatR" Version="14.2.0" />
		<PackageReference Include="Microsoft.AspNetCore.JsonPatch" Version="10.0.10" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.3.11" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.1" />
		<PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Infrastructure\Swagger\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Karya.Core.App\Karya.Core.App.csproj" />
	</ItemGroup>

</Project>
